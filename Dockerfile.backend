# Backend Prod — Ubuntu 24.04 + TSDuck + Node 20
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Ho_Chi_Minh \
    NODE_MAJOR=20

# 1. Cài đặt Node.js và các công cụ cần thiết. Tải TSDuck (bản Debian 12 Bookworm) trực tiếp bằng wget.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg lsb-release procps wget libedit2 libpcsclite1 libsrt1.5-openssl libusb-1.0-0 \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL --retry 5 https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && wget -qO tsduck.deb http://ftp.us.debian.org/debian/pool/main/t/tsduck/tsduck_3.33-3139-1_amd64.deb \
    && wget -qO tsduck-dev.deb http://ftp.us.debian.org/debian/pool/main/t/tsduck/tsduck-dev_3.33-3139-1_amd64.deb \
    && apt-get install -y --no-install-recommends ./tsduck.deb ./tsduck-dev.deb \
    && rm -rf /var/lib/apt/lists/* tsduck.deb tsduck-dev.deb \
    && node --version && tsp --version

# 2. Thư mục chuẩn VTC (trùng path trong code).
RUN mkdir -p /media/ramdisk/live \
             /mnt/Data/catchup/captures \
             /mnt/Data/catchup/exports \
             /opt/vtc/conf/sources \
             /app

WORKDIR /app

# 3. Build backend
COPY apps/backend/package.json apps/backend/package-lock.json apps/backend/tsconfig.json ./
RUN npm ci
COPY apps/backend/src ./src
RUN ./node_modules/.bin/tsc -p tsconfig.json && npm prune --omit=dev

ENV PORT=8080 \
    VTC_CONF_DIR=/opt/vtc/conf/sources \
    VTC_CAPTURE_DIR=/mnt/Data/catchup/captures \
    VTC_EXPORTS_DIR=/mnt/Data/catchup/exports \
    VTC_LIVE_DIR=/media/ramdisk/live

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8080/health').then(r=>{if(!r.ok)process.exit(1)})" || exit 1
CMD ["node", "dist/server.js"]
