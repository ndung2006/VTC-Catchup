# Backend Prod — Ubuntu 24.04 + TSDuck (Compiled from source) + Node 20
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Ho_Chi_Minh \
    NODE_MAJOR=20

# 1. Cài đặt các gói phụ thuộc để Build TSDuck và Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg lsb-release procps wget git build-essential \
      dos2unix coreutils findutils diffutils grep sed gawk \
      libedit-dev libpcsclite-dev libusb-1.0-0-dev \
      libcurl4-openssl-dev libssl-dev zlib1g-dev \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL --retry 5 https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# 2. Biên dịch TSDuck từ mã nguồn Github (Chặn tuyệt đối việc tạo HTML Docs để tránh lỗi Asciidoctor)
WORKDIR /tmp
RUN git clone --branch v3.39-3956 --depth 1 https://github.com/tsduck/tsduck.git \
    && cd tsduck \
    && sed -i 's/docs-html//g' Makefile \
    && sed -i 's/docs-pdf//g' Makefile \
    && make -j$(nproc) NOTEST=1 NODOC=1 \
    && make install-tools NODOC=1 \
    && cd /tmp && rm -rf tsduck \
    && node --version && tsp --version

# 3. Thư mục chuẩn VTC (trùng path trong code).
RUN mkdir -p /media/ramdisk/live \
             /mnt/Data/catchup/captures \
             /mnt/Data/catchup/exports \
             /opt/vtc/conf/sources \
             /app

WORKDIR /app

# 4. Build backend
COPY apps/backend/package.json apps/backend/package-lock.json apps/backend/tsconfig.json ./
RUN npm ci
COPY apps/backend/src ./src
RUN ./node_modules/.bin/tsc -p tsconfig.json && npm prune --omit=dev

ENV PORT=8080 \
    VTC_CONF_DIR=/opt/vtc/conf/sources \
    VTC_CAPTURE_DIR=/mnt/Data/catchup/captures \
    VTC_EXPORTS_DIR=/mnt/Data/catchup/exports \
    VTC_LIVE_DIR=/media/ramdisk/live

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8080/health').then(r=>{if(!r.ok)process.exit(1)})" || exit 1
CMD ["node", "dist/server.js"]
