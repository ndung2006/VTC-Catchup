# Backend để proxy /api (dev). Prod: origin của API server.
VTC_API_ORIGIN=http://127.0.0.1:8080
# Gốc phục vụ file HLS (.m3u8/.ts).
# - Dev (next dev không serve /hls): chạy `docker compose --profile demo up demo-hls`
#   rồi đặt http://localhost:8081/hls
# - Prod: Nginx serve từ RAMDisk, dùng /hls (cùng origin, có anti-hotlink).
NEXT_PUBLIC_HLS_BASE=http://localhost:8081/hls
